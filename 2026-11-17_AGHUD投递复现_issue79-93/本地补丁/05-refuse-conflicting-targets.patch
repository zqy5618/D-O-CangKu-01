+/// The caller's id as the snapshot names its session (`antigravity:…`,
+/// `deepseek:…`, or the client's own id), so a message header shows the same
+/// id list_sessions and get_message do.
+pub(crate) fn caller_id(snapshot: &Value, client: &str, id: &str) -> String {
+    find_in(snapshot, client, id)
+        .and_then(|session| session["id"].as_str())
+        .unwrap_or(id)
+        .to_owned()
+}

+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { configuredVendors, type HUDConfig } from "../src/model.ts";
+import type { Snapshot } from "@agent-hud/protocol";
+
+const baseConfig: HUDConfig = {
+  mode: "simple",
+  animations: false,
+  sound: false,
+  theme: "system",
+  panelLayout: {},
+} as never;
+
+test("configuredVendors picks the first active configured row over tightest", () => {
+  const snapshot: Snapshot = {
+    language: "en",
+    quotas: [
+      {
+        id: "codex:5h",
+        legacyWindowId: "acct1/5h",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "5h",
+        usedPercent: 35,
+        status: "normal",
+        resetAt: new Date(Date.now() + 3600_000).toISOString(),
+      },
+      {
+        id: "codex:week",
+        legacyWindowId: "acct1/week",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "Week",
+        usedPercent: 85,
+        status: "warning",
+        resetAt: new Date(Date.now() + 86400_000).toISOString(),
+      },
+    ],
+    billing: [],
+    providers: [],
+    approvals: [],
+    sessions: [],
+    settings: { animations: false },
+  } as never;
+
+  // 1. Without layout: defaults to tightest (week = 85%)
+  const defaultVendors = configuredVendors(snapshot, baseConfig);
+  const openai = defaultVendors.find((v) => v.key === "openai");
+  assert.equal(openai?.used, 85);
+  assert.equal(openai?.level, "warning");
+
+  // 2. With row ordering in "codex" provider block: picks 5h (35%)
+  const configWithRows: HUDConfig = {
+    ...baseConfig,
+    panelLayout: {
+      blocks: {
+        codex: {
+          rows: ["5h", "week"],
+        },
+      },
+    },
+  };
+  const vendors2 = configuredVendors(snapshot, configWithRows);
+  const openai2 = vendors2.find((v) => v.key === "openai");
+  assert.equal(openai2?.used, 35);
+  assert.equal(openai2?.level, "normal");
+
+  // 3. Hidden block is skipped: falls back to tightest (85%)
+  const configWithHiddenBlock: HUDConfig = {
+    ...baseConfig,
+    panelLayout: {
+      blocks: {
+        codex: {
+          hidden: true,
+          rows: ["5h", "week"],
+        },
+      },
+    },
+  };
+  const vendors3 = configuredVendors(snapshot, configWithHiddenBlock);
+  const openai3 = vendors3.find((v) => v.key === "openai");
+  assert.equal(openai3?.used, 85);
+  assert.equal(openai3?.level, "warning");
+});
+
+test("configuredVendors does not let a stale or expired first row mask tightest alerts", () => {
+  const staleFirstSnapshot: Snapshot = {
+    language: "en",
+    quotas: [
+      {
+        id: "codex:5h",
+        legacyWindowId: "acct1/5h",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "5h",
+        usedPercent: 0,
+        status: "stale",
+        resetAt: new Date(Date.now() + 3600_000).toISOString(),
+      },
+      {
+        id: "codex:week",
+        legacyWindowId: "acct1/week",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "Week",
+        usedPercent: 99,
+        status: "critical",
+        resetAt: new Date(Date.now() + 86400_000).toISOString(),
+      },
+    ],
+    billing: [],
+    providers: [],
+    approvals: [],
+    sessions: [],
+    settings: { animations: false },
+  } as never;
+
+  const configWithRows: HUDConfig = {
+    ...baseConfig,
+    panelLayout: {
+      blocks: {
+        codex: {
+          rows: ["5h", "week"],
+        },
+      },
+    },
+  };
+
+  const vendors = configuredVendors(staleFirstSnapshot, configWithRows);
+  const openai = vendors.find((v) => v.key === "openai");
+  assert.equal(openai?.used, 99);
+  assert.equal(openai?.level, "critical");
+
+  // Expired resetAt row is also skipped
+  const expiredFirstSnapshot: Snapshot = {
+    ...staleFirstSnapshot,
+    quotas: [
+      {
+        id: "codex:5h",
+        legacyWindowId: "acct1/5h",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "5h",
+        usedPercent: 10,
+        status: "normal",
+        resetAt: new Date(Date.now() - 3600_000).toISOString(), // 1h in past
+      },
+      {
+        id: "codex:week",
+        legacyWindowId: "acct1/week",
+        accountId: "acct1",
+        vendor: "codex",
+        name: "Week",
+        usedPercent: 70,
+        status: "warning",
+        resetAt: new Date(Date.now() + 86400_000).toISOString(),

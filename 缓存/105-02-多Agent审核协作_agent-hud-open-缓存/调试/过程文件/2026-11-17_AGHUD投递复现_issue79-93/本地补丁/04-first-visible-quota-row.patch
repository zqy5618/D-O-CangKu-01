+  const vendorsExpired = configuredVendors(expiredFirstSnapshot, configWithRows);
+  const openaiExpired = vendorsExpired.find((v) => v.key === "openai");
+  assert.equal(openaiExpired?.used, 70);
+  assert.equal(openaiExpired?.level, "warning");
+});

+fn quota_row_matches(quota: &Value, key: &str) -> bool {
+    let id = quota["id"].as_str().unwrap_or("");
+    if id == key {
+        return true;
+    }
+    if let Some(legacy) = quota["legacyWindowId"].as_str() {
+        if legacy == key {
+            return true;
+        }
+        if let Some(account_id) = quota["accountId"].as_str() {
+            if let Some(suffix) = legacy.strip_prefix(account_id) {
+                if let Some(rest) = suffix.strip_prefix('/') {
+                    if rest == key {
+                        return true;
+                    }
+                }
+            }
+        }
+    }
+    false
+}
+
+fn quota_account_key(quota: &Value) -> &str {
+    quota["accountId"]
+        .as_str()
+        .or_else(|| quota["account"].as_str())
+        .unwrap_or("unassigned")
+}
+
+fn is_quota_active(q: &Value, now_ms: i64) -> bool {
+    if !q["usedPercent"].is_number() || q["status"].as_str() == Some("stale") {
+        return false;
+    }
+    if let Some(reset_str) = q["resetAt"].as_str() {
+        if let Ok(at) = chrono::DateTime::parse_from_rfc3339(reset_str) {
+            if at.timestamp_millis() <= now_ms {
+                return false;
+            }
+        }
+    }
+    true
+}
